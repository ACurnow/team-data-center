# Copy to deploy/.env on the VPS (git ignores it) and fill in.

# Cloudflare Tunnel token for the "team-data-center" tunnel (Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=

# Live what-if panel on the Warm Ishikari page (OpenAI-compatible endpoint, dcopt.common.llm).
# Empty = panel off; the page shows how to turn it on.
CF_API_KEY=
# CARBONFORGE_BASE_URL=
# LLM_MODEL=

# Solver threads per solve, and the resource caps of the app container (4 cores / 8 GB VPS).
DCOPT_THREADS=2
APP_CPUS=3
APP_MEMORY=6g

# Shown in experiment results; set by `GIT_COMMIT=$(git rev-parse --short HEAD) docker compose ...`.
# GIT_COMMIT=
